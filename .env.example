# Environment variables. Copy to .env.local (never committed) and fill in.
# Each block names its vendor; details and dashboards are in docs/VENDORS.md.

# --- Supabase ---
# From Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# --- Inngest ---
# Production only; local dev uses `npm run jobs:dev`, no keys needed)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
